<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa base del canvas de 108 x 108 dp según especificación oficial -->
    <item
        android:width="108dp"
        android:height="108dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size
                android:width="108dp"
                android:height="108dp" />
        </shape>
    </item>
    <!-- Logotipo visible contenido dentro de la zona segura de 72 x 72 dp centrales para no ser recortado -->
    <item
        android:width="68dp"
        android:height="68dp"
        android:drawable="@drawable/icono"
        android:gravity="center" />
</layer-list>
